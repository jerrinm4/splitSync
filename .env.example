# SplitSync — public browser configuration
# Copy this file to .env and fill in your values.
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase publishable (anon) key — safe to use in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy projects can use VITE_SUPABASE_KEY instead.
# Never put service-role keys, database passwords or OAuth client secrets in VITE_* variables.
